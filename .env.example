# ============================================================================
# رمال فلو (Rimal Flow) — متغيرات البيئة
# انسخ هذا الملف إلى ".env" محلياً (أو عرّف نفس المفاتيح في إعدادات مشروع Vercel
# عند النشر) واملأ القيم الحقيقية. لا ترفع ملف ".env" الفعلي لأي مستودع Git أبداً.
# ============================================================================

# --- Database ---------------------------------------------------------------
# محلياً: أي PostgreSQL يعمل على جهازك.
# على Vercel: خدمات serverless لا تصل لقاعدة على localhost — استخدم قاعدة مُستضافة
# (Vercel Postgres / Neon / Supabase / Railway...) وضع رابط الاتصال الذي تعطيك إياه هنا.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rimal_flow?schema=public"

# --- NextAuth ----------------------------------------------------------------
# محلياً: http://localhost:3000
# على Vercel: رابط النشر الفعلي، مثال: https://rimal-flow.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# ولّد قيمة عشوائية آمنة بأمر: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_TO_A_RANDOM_LONG_SECRET"

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="رمال فلو"
NEXT_PUBLIC_COMPANY_NAME="رمال X"

# رمز QR الثابت الخاص بالمقر (محاكاة) — يُستخدم في صفحة الحجز وفي التحقق عند
# تسجيل الحضور/الانصراف. ماسح الكاميرا (getUserMedia) يعمل تلقائياً بدون أي إعداد
# إضافي محلياً (localhost يُعامَل كسياق آمن) وأيضاً بعد النشر على Vercel (HTTPS افتراضياً)،
# بما في ذلك من متصفح الجوال مباشرة.
NEXT_PUBLIC_VENUE_QR_CODE="RIMALX-HQ-MAIN-BRANCH-0001"

# --- محول الربط الخارجي (SECURITY-AUDIT.md §4، FLOW-C09) ---------------------
# سرّ HMAC-SHA256 مشترك يوقّع به أي نظام ربط خارجي طلباته إلى
# POST /api/integrations/attendance-events. ولّد قيمة عشوائية آمنة بأمر:
# openssl rand -base64 32 — وشاركها فقط مع النظام الخارجي عبر قناة آمنة، ليست
# نفس NEXTAUTH_SECRET أو أي سرّ آخر.
INTEGRATION_HMAC_SECRET="CHANGE_ME_TO_A_RANDOM_LONG_SECRET"

# --- وضع التجربة (اختياري، للتطوير المحلي فقط) --------------------------------
# "true" يُرخي القيود الزمنية وحدها عند تسجيل الحضور/الانصراف (نافذة الوصول
# ±30 دقيقة، ونافذة الباقة الشهرية اليومية) لتسهيل تجربة السيناريوهات بلا انتظار.
# كل ما عداه يبقى مفعّلاً: آلة الحالة، الصلاحيات، ذرية العمليات، واستهلاك رمز
# المسح لمرة واحدة. لا يعمل في الإنتاج إطلاقاً مهما ضُبط (راجع src/lib/test-mode.ts).
RELAX_ATTENDANCE_WINDOW="false"
