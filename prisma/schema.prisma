// ============================================================================
// رمال فلو (Rimal Flow) — Prisma Schema
// مركز العمليات الذكي للحجوزات والمساحات — رمال X
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  USER // عميل عادي
  RECEPTION // موظف استقبال
  ADMIN // مدير
  SUPER_ADMIN // مدير عام (صلاحيات كاملة)
}

enum BookingType {
  HOURLY // ساعة
  FOUR_HOUR // 4 ساعات
  DAILY // يومي
  MONTHLY_MORNING // شهري صباحي
  MONTHLY_EVENING // شهري مسائي
}

enum BookingStatus {
  PENDING // بانتظار التأكيد
  CONFIRMED // مؤكد
  CHECKED_IN // تم تسجيل الحضور
  CHECKED_OUT // تم تسجيل الانصراف
  CANCELLED // ملغى
  NO_SHOW // لم يحضر
}

enum CheckAction {
  CHECK_IN
  CHECK_OUT
}

// ----------------------------------------------------------------------------
// User — العملاء والموظفون
// ----------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  name            String
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String?
  role            Role     @default(USER)
  // صلاحيات مفصلة على مستوى الإجراءات لموظفي الاستقبال/المدراء
  // مثال: { "canCheckIn": true, "canCancelBooking": true, "canManageSpaces": false }
  permissions     Json?
  isStudent       Boolean  @default(false)
  studentIdNumber String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings        Booking[]     @relation("UserBookings")
  performedChecks CheckInLog[]  @relation("StaffCheckLogs")

  @@index([role])
  @@map("users")
}

// ----------------------------------------------------------------------------
// Space — المساحات وأسعارها
// ----------------------------------------------------------------------------

model Space {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  nameEn      String?
  description String?

  // عدد الوحدات المتاحة من هذا النوع من المساحات (طاقة استيعابية للحجز المتزامن)
  capacityUnits Int @default(1)

  // بنية الأسعار (SAR) — تُترك null إن كانت الباقة غير متاحة لهذه المساحة
  hourlyPrice          Decimal? @db.Decimal(10, 2)
  fourHourPrice        Decimal? @db.Decimal(10, 2)
  dailyPrice           Decimal? @db.Decimal(10, 2)
  monthlyMorningPrice  Decimal? @db.Decimal(10, 2)
  monthlyEveningPrice  Decimal? @db.Decimal(10, 2)

  // نسبة خصم الطلاب (0 = بدون خصم), مثال 0.15 = 15%
  studentDiscount Decimal @default(0) @db.Decimal(4, 3)

  // التوفر الأسبوعي: خريطة اليوم -> {open, close} بصيغة 24 ساعة
  // مثال: { "sun": {"open":"08:00","close":"22:00"}, ... }
  weeklyAvailability Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@map("spaces")
}

// ----------------------------------------------------------------------------
// Booking — الحجوزات
// ----------------------------------------------------------------------------

model Booking {
  id          String @id @default(cuid())
  bookingCode String @unique // كود مختصر قابل للقراءة يُعرض للعميل، مثال: RMX-7F3K2A

  // رمز QR فريد خاص بهذا الحجز تحديداً — يُولَّد تلقائياً عند الإنشاء، يصل إليه
  // العميل من حسابه، ويُمسَح عند الاستقبال لتسجيل الحضور/الانصراف. يحل محل رمز
  // QR الثابت الواحد الذي كان يُستخدَم لكل العملاء سابقاً.
  qrToken String @unique @default(cuid())

  userId String?
  user   User?   @relation("UserBookings", fields: [userId], references: [id])

  // بيانات حجز الضيف (Guest) بدون حساب
  guestName  String?
  guestPhone String?
  guestEmail String?

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id])

  // رقم المقعد المرئي على خريطة المقر (0-based) — يُملأ فقط عندما يُسكِّن موظف
  // الاستقبال العميل يدوياً عبر البحث والتخصيص من الخريطة. الحجوزات العادية عبر
  // صفحة الحجز العامة تبقى null ولا تظهر مشغولة تلقائياً على الخريطة — عرض
  // الإشغال على الخريطة مقصود أن يكون يدوياً بالكامل، وليس مشتقاً تلقائياً من حالة الحجز.
  seatIndex Int?

  bookingType BookingType
  startTime   DateTime
  endTime     DateTime

  isStudent Boolean @default(false)

  // كل الحسابات المالية تُحتسب وتُخزّن من السيرفر فقط — لا تُقبل من العميل
  basePrice      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  finalPrice     Decimal @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkInLogs CheckInLog[]

  @@index([spaceId, startTime, endTime])
  @@index([spaceId, seatIndex])
  @@index([status])
  @@index([userId])
  @@map("bookings")
}

// ----------------------------------------------------------------------------
// CheckInLog — سجل تسجيل الحضور/الانصراف (لمنع الاحتيال والتكرار)
// ----------------------------------------------------------------------------

model CheckInLog {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  action    CheckAction
  timestamp DateTime    @default(now())

  // موظف الاستقبال الذي نفّذ الإجراء (اختياري: قد يكون ذاتي الخدمة عبر QR)
  performedById String?
  performedBy   User?   @relation("StaffCheckLogs", fields: [performedById], references: [id])

  // مهلة الوصول للمقعد (30 ثانية) والمؤقت التنازلي الفعلي — تُملأ فقط لسجلات
  // من نوع CHECK_IN الناجحة. actualStartTime = timestamp + 30 ثانية (لحظة بدء
  // احتساب وقت الحجز المدفوع فعلياً)، وexpectedEndTime = actualStartTime + مدة الحجز.
  bufferEndsAt    DateTime?
  actualStartTime DateTime?
  expectedEndTime DateTime?

  ipAddress    String?
  deviceInfo   String?
  success      Boolean @default(true)
  failureReason String?

  // مفتاح تكرار اختياري (Idempotency Key) — يُستخدَم فقط من مسار التكامل الرسمي
  // POST /api/bookings/:id/check-in (عقد التكامل §10) لمنع معالجة نفس حدث تسجيل
  // الحضور مرتين عند إعادة الإرسال (Replay). @unique يسمح بقيم NULL متعددة في
  // Postgres (لا يفرض التفرّد إلا بين القيم غير الفارغة فعلياً).
  idempotencyKey String? @unique

  @@index([bookingId, action, timestamp])
  @@map("check_in_logs")
}
